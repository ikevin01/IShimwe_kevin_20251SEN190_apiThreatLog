        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    CLIENT_SESSIONS ||--o{ API_REQUESTS : \&quot;initiates (1:N)\&quot;\n    API_ENDPOINTS ||--o{ API_REQUESTS : \&quot;receives (1:N)\&quot;\n    API_REQUESTS ||--|| REQUEST_LEXICAL_METRICS : \&quot;measured_by (1:1)\&quot;\n    API_REQUESTS ||--o| SECURITY_THREATS : \&quot;flagged_as (1:0..1)\&quot;\n    SECURITY_THREATS ||--o{ THREAT_AUDIT_LOG : \&quot;audited_in (1:N)\&quot;\n\n    CLIENT_SESSIONS {\n        NUMBER session_id PK \&quot;NOT NULL, SEQ_SESSION_ID\&quot;\n        VARCHAR2 source_ip UK \&quot;NOT NULL, UNIQUE (45)\&quot;\n        VARCHAR2 source_country \&quot;DEFAULT &#39;UNKNOWN&#39; (60)\&quot;\n        VARCHAR2 user_agent_family \&quot;DEFAULT &#39;GENERIC&#39; (100)\&quot;\n        NUMBER total_requests \&quot;DEFAULT 0, CHECK &gt;= 0\&quot;\n        NUMBER flagged_requests \&quot;DEFAULT 0, CHECK &gt;= 0\&quot;\n        VARCHAR2 session_status \&quot;ACTIVE | FLAGGED | QUARANTINED\&quot;\n        TIMESTAMP first_seen_at \&quot;NOT NULL, DEFAULT SYSTIMESTAMP\&quot;\n        TIMESTAMP last_seen_at \&quot;NOT NULL, DEFAULT SYSTIMESTAMP\&quot;\n    }\n\n    API_ENDPOINTS {\n        NUMBER endpoint_id PK \&quot;NOT NULL, SEQ_ENDPOINT_ID\&quot;\n        VARCHAR2 http_method UK \&quot;NOT NULL, GET|POST|PUT|DELETE|PATCH\&quot;\n        VARCHAR2 endpoint_path UK \&quot;NOT NULL, UNIQUE WITH method (255)\&quot;\n        VARCHAR2 service_module \&quot;DEFAULT &#39;CORE_API&#39; (80)\&quot;\n        NUMBER sensitivity_level \&quot;DEFAULT 2, CHECK 1..5\&quot;\n        NUMBER is_public \&quot;DEFAULT 1, CHECK IN (0,1)\&quot;\n        TIMESTAMP created_at \&quot;NOT NULL, DEFAULT SYSTIMESTAMP\&quot;\n    }\n\n    API_REQUESTS {\n        NUMBER request_id PK \&quot;NOT NULL, SEQ_REQUEST_ID\&quot;\n        NUMBER session_id FK \&quot;NOT NULL -&gt; CLIENT_SESSIONS\&quot;\n        NUMBER endpoint_id FK \&quot;NOT NULL -&gt; API_ENDPOINTS\&quot;\n        VARCHAR2 raw_record_hash UK \&quot;NOT NULL, UNIQUE (64)\&quot;\n        VARCHAR2 query_string \&quot;NULLABLE (1000)\&quot;\n        VARCHAR2 request_body \&quot;NULLABLE (4000)\&quot;\n        VARCHAR2 content_type \&quot;DEFAULT &#39;application/json&#39; (100)\&quot;\n        NUMBER payload_bytes \&quot;DEFAULT 0, CHECK &gt;= 0\&quot;\n        NUMBER http_status_code \&quot;DEFAULT 200, CHECK 100..599\&quot;\n        TIMESTAMP request_timestamp \&quot;NOT NULL, DEFAULT SYSTIMESTAMP\&quot;\n    }\n\n    REQUEST_LEXICAL_METRICS {\n        NUMBER metric_id PK \&quot;NOT NULL, SEQ_METRIC_ID\&quot;\n        NUMBER request_id FK,UK \&quot;NOT NULL, UNIQUE -&gt; API_REQUESTS\&quot;\n        NUMBER path_length \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER path_special_chars \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER path_digits \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER path_badwords \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER query_length \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER query_special_chars \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER query_digits \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER query_badwords \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER body_length \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER body_special_chars \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER body_digits \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER body_badwords \&quot;NOT NULL, CHECK &gt;= 0\&quot;\n        NUMBER total_badwords \&quot;VIRTUAL GENERATED ALWAYS\&quot;\n    }\n\n    SECURITY_THREATS {\n        NUMBER threat_id PK \&quot;NOT NULL, SEQ_THREAT_ID\&quot;\n        NUMBER request_id FK,UK \&quot;NOT NULL, UNIQUE -&gt; API_REQUESTS\&quot;\n        NUMBER actual_class \&quot;NOT NULL, CHECK IN (0,1)\&quot;\n        NUMBER model_prediction \&quot;NOT NULL, CHECK IN (0,1)\&quot;\n        NUMBER risk_score \&quot;NOT NULL, CHECK 0..100\&quot;\n        VARCHAR2 severity_tier \&quot;LOW | MEDIUM | HIGH | CRITICAL\&quot;\n        VARCHAR2 attack_vector \&quot;SQLI | XSS | PATH_TRAVERSAL | ANOMALY | BENIGN\&quot;\n        VARCHAR2 mitigation_action \&quot;LOGGED | RATE_LIMITED | BLOCKED | QUARANTINED\&quot;\n        TIMESTAMP detected_at \&quot;NOT NULL, DEFAULT SYSTIMESTAMP\&quot;\n    }\n\n    THREAT_AUDIT_LOG {\n        NUMBER audit_id PK \&quot;NOT NULL, SEQ_AUDIT_ID\&quot;\n        NUMBER threat_id FK \&quot;NULLABLE -&gt; SECURITY_THREATS\&quot;\n        NUMBER session_id \&quot;NULLABLE\&quot;\n        VARCHAR2 event_type \&quot;NOT NULL (50)\&quot;\n        VARCHAR2 action_taken \&quot;NOT NULL (50)\&quot;\n        VARCHAR2 actor_username \&quot;NOT NULL, DEFAULT USER (60)\&quot;\n        VARCHAR2 details \&quot;NULLABLE (500)\&quot;\n        TIMESTAMP logged_at \&quot;NOT NULL, DEFAULT SYSTIMESTAMP\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Nkrij-8jpFQotyQdMTOX-1">
